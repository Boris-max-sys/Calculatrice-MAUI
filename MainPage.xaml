<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculatrice.MainPage" BackgroundColor="#1E1E1E">
  <ContentPage.Resources>
    <Style TargetType="Button">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BackgroundColor" Value="#3A3A3C"/>
      <Setter Property="TextColor" Value="White"/>
      <Setter Property="MinimumHeightRequest" Value="60"/>
    </Style>
  </ContentPage.Resources>

  <ScrollView>
    <VerticalStackLayout Padding="12" Spacing="10">

      <Border StrokeShape="RoundRectangle 14" BackgroundColor="#111111" Padding="14">
        <VerticalStackLayout>
          <Label x:Name="OperationLabel" TextColor="Gray" FontSize="18" HorizontalTextAlignment="End"/>
          <Label x:Name="ResultLabel" Text="0" TextColor="White" FontSize="44"
                 HorizontalTextAlignment="End" LineBreakMode="TailTruncation"/>
        </VerticalStackLayout>
      </Border>

      <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
        <Button Text="√" Clicked="OnSqrt" WidthRequest="100"/>
        <Button Text="x²" Clicked="OnSquare" WidthRequest="100"/>
      </HorizontalStackLayout>

      <Grid RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*,*"
            RowSpacing="8" ColumnSpacing="8" MinimumHeightRequest="380">
        <Button Text="AC" Clicked="OnClear"     Grid.Row="0" Grid.Column="0" BackgroundColor="#A5292A"/>
        <Button Text="⌫"  Clicked="OnBackspace" Grid.Row="0" Grid.Column="1"/>
        <Button Text="%"  Clicked="OnPercent"   Grid.Row="0" Grid.Column="2"/>
        <Button Text="÷"  Clicked="OnOperator"  Grid.Row="0" Grid.Column="3" BackgroundColor="#FF9500"/>

        <Button Text="7" Clicked="OnDigit" Grid.Row="1" Grid.Column="0"/>
        <Button Text="8" Clicked="OnDigit" Grid.Row="1" Grid.Column="1"/>
        <Button Text="9" Clicked="OnDigit" Grid.Row="1" Grid.Column="2"/>
        <Button Text="×" Clicked="OnOperator" Grid.Row="1" Grid.Column="3" BackgroundColor="#FF9500"/>

        <Button Text="4" Clicked="OnDigit" Grid.Row="2" Grid.Column="0"/>
        <Button Text="5" Clicked="OnDigit" Grid.Row="2" Grid.Column="1"/>
        <Button Text="6" Clicked="OnDigit" Grid.Row="2" Grid.Column="2"/>
        <Button Text="−" Clicked="OnOperator" Grid.Row="2" Grid.Column="3" BackgroundColor="#FF9500"/>

        <Button Text="1" Clicked="OnDigit" Grid.Row="3" Grid.Column="0"/>
        <Button Text="2" Clicked="OnDigit" Grid.Row="3" Grid.Column="1"/>
        <Button Text="3" Clicked="OnDigit" Grid.Row="3" Grid.Column="2"/>
        <Button Text="+" Clicked="OnOperator" Grid.Row="3" Grid.Column="3" BackgroundColor="#FF9500"/>

        <Button Text="±" Clicked="OnSign"   Grid.Row="4" Grid.Column="0"/>
        <Button Text="0" Clicked="OnDigit"  Grid.Row="4" Grid.Column="1"/>
        <Button Text="." Clicked="OnDot"    Grid.Row="4" Grid.Column="2"/>
        <Button Text="=" Clicked="OnEquals" Grid.Row="4" Grid.Column="3" BackgroundColor="#34C759"/>
      </Grid>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
